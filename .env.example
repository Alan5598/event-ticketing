PORT=5000

MONGODB_USER="your_db_username"
MONGODB_PASSWORD="your_db_password"

MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/<DB_NAME>?retryWrites=true&w=majority"

# JWT Secret
JWT_SECRET="your_jwt_secret_key"

# Admin Credentials
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="YourAdminPassword123!"

# Frontend URL (for password reset redirection)
FRONTEND_URL="http://localhost:3000"

# EmailJS Configuration
EMAILJS_SERVICE_ID="your_emailjs_service_id"
EMAILJS_TEMPLATE_ID_OTP="your_emailjs_otp_template_id"
EMAILJS_TEMPLATE_ID_RESET="your_emailjs_reset_template_id"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
EMAILJS_PRIVATE_KEY="your_emailjs_private_key"
